# Monday.com API Configuration
# ========================================
# Get your API key from: Monday.com → Profile → Admin → API
# Create a board for leads and get the Board ID from the URL
MONDAY_API_KEY=your_monday_api_key_here
MONDAY_BOARD_ID=your_board_id_here

# Calendly Configuration
# ========================================
# Your Calendly scheduling page URL
# Example: https://calendly.com/your-username
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/jorgeporras

# Optional: Calendly Customization
# ========================================
# Customize the appearance of the Calendly widget to match your brand
# Background color (hex without #)
NEXT_PUBLIC_CALENDLY_BACKGROUND=0a0a0a
# Primary/accent color (hex without #)
NEXT_PUBLIC_CALENDLY_PRIMARY=ff4d00
# Text color (hex without #)
NEXT_PUBLIC_CALENDLY_TEXT=ffffff

# Email Configuration (for contact form - Future)
# ========================================
# Option A: Resend (Recommended)
# RESEND_API_KEY=re_xxxxxxxxxx
# RESEND_FROM_EMAIL=hola@sutilde.com
# RESEND_TO_EMAIL=info@sutilde.com

# Option B: SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxx
# SENDGRID_FROM_EMAIL=hola@sutilde.com
# SENDGRID_TO_EMAIL=info@sutilde.com

# Option C: SMTP (Gmail, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=hola@sutilde.com

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
